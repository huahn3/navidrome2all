# scripts/xiaomi_test_server.go 的环境变量模板
#
# 复制成 .env（已被 .gitignore 忽略），按需填写，然后用下面方式启动：
#   cd scripts && set -a && . ./.env && set +a && go run xiaomi_test_server.go
#
# 这些值是**真实凭据**，绝对不要提交回仓库。

# 小米账号（account.xiaomi.com 的 userId）
XIAOMI_ACCOUNT=
# 小米 passToken（登录米家后可在浏览器 Cookie 里看到，形如 "V1:xxxx"）
XIAOMI_PASS_TOKEN=

# Navidrome 实例地址（用于让音箱回拉音频流 + 转发播控命令）
NAVIDROME_BASE=http://127.0.0.1:4533
NAVIDROME_USER=
# 明文密码：只为拼 Subsonic 流地址的 t=md5(password+salt)，可与 JWT 二选一
NAVIDROME_PASSWORD=
# Native API 的 JWT（X-ND-Authorization: Bearer <JWT>）。
# 拿法：curl -s -X POST $NAVIDROME_BASE/auth/login -H 'Content-Type: application/json' \
#        -d '{"username":"<user>","password":"<pass>"}' | jq -r .token
NAVIDROME_JWT=
